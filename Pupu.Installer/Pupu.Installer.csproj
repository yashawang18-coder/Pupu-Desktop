<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Pupu.Installer</AssemblyName>
    <RootNamespace>Pupu.Installer</RootNamespace>
    <ApplicationIcon>..\Pupu.Desktop\Assets\pupu.ico</ApplicationIcon>
    <Title>朴朴桌面宠物安装程序</Title>
    <Description>朴朴桌面宠物一键安装程序</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(PupuPayloadZip)' != '' and Exists('$(PupuPayloadZip)')">
    <EmbeddedResource Include="$(PupuPayloadZip)" LogicalName="Pupu.Installer.Payload.zip" />
  </ItemGroup>

  <Target Name="RequireInstallerPayload"
          BeforeTargets="Publish"
          Condition="'$(PupuPayloadZip)' == '' or !Exists('$(PupuPayloadZip)')">
    <Error Text="缺少安装载荷。请通过 scripts/build-windows.ps1 构建安装程序。" />
  </Target>
</Project>
