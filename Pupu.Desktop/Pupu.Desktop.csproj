<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Pupu</AssemblyName>
    <RootNamespace>Pupu.Desktop</RootNamespace>
    <ApplicationIcon>Assets\pupu.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pupu.Behavior\Pupu.Behavior.csproj" />
    <ProjectReference Include="..\Pupu.Application\Pupu.Application.csproj" />
    <ProjectReference Include="..\Pupu.Platform.Windows\Pupu.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\PetModels.cs;Models\AlbumModels.cs" />
    <Compile Remove="Services\AlbumExperienceService.cs;Services\BehaviorDecisionLogger.cs;Services\CodexIterationService.cs;Services\ConversationSessionStore.cs;Services\DesktopRoutePlanner.cs;Services\EnvironmentContextService.cs;Services\LocalPetStore.cs;Services\MemoryEngine.cs;Services\ModelApiService.cs;Services\ModelProtocolAdapter.cs;Services\NaturalLanguageRuleService.cs;Services\PhotoAlbumService.cs;Services\StoragePaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\pupu-assets.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- The manifest is authoritative. verify-asset-manifest.ps1 rejects any
         unregistered or missing runtime PNG before build and after publish. -->
    <Content Include="Assets\**\*.png"
             Exclude="Assets\pupu-icon.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Resource Include="Assets\pupu-icon.png" />
    <Resource Include="Assets\pupu.ico" />
  </ItemGroup>

  <Target Name="VerifyAssetManifestContract"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\verify-asset-manifest.ps1&quot;" />
  </Target>
</Project>
